+//
+//  MenuView.swift
+//  voxim
+//
+
+import KeyboardShortcuts
+import SwiftUI
+
+struct MenuView: View {
+    @Bindable var controller: AppController
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Text("voxim").font(.headline)
+                Spacer()
+                Text(controller.activeEngine).font(.caption).foregroundStyle(.secondary)
+            }
+            status
+
+            Divider()
+            targetSection
+
+            Divider()
+            HStack {
+                Text("Agent push-to-talk")
+                Spacer()
+                KeyboardShortcuts.Recorder(for: .agentPushToTalk)
+            }
+
+            Divider()
+            Button("Quit voxim") { NSApplication.shared.terminate(nil) }
+                .buttonStyle(.link)
+        }
+        .padding(14)
+        .frame(width: 340)
+        .task { await controller.targets.refresh() }
+    }
+
+    @ViewBuilder private var status: some View {
+        switch controller.phase {
+        case .idle:
+            Label("Ready", systemImage: "checkmark.circle").foregroundStyle(.green)
+        case .recording:
+            Label("Recording", systemImage: "record.circle.fill").foregroundStyle(.red)
+        case .transcribing:
+            Label("Transcribing…", systemImage: "waveform")
+        case .pending:
+            Label("Waiting for confirmation", systemImage: "text.cursor")
+        case .sending:
+            Label("Sending…", systemImage: "paperplane")
+        case .sent(let label):
+            Label("Injected into \(label)", systemImage: "paperplane.fill").foregroundStyle(.green)
+        case .failed(let message):
+            Label(message, systemImage: "exclamationmark.triangle.fill").foregroundStyle(.orange)
+        }
+    }
+
+    @ViewBuilder private var targetSection: some View {
+        let targets = controller.targets
+        HStack {
+            Text("Claude Code target").font(.subheadline.weight(.semibold))
+            Spacer()
+            Button {
+                Task { await targets.refresh() }
+            } label: {
+                Image(systemName: "arrow.clockwise")
+            }
+            .buttonStyle(.borderless)
+            .help("Refresh tmux panes")
+        }
+
+        if let error = targets.listError {
+            Label(error, systemImage: "exclamationmark.triangle").font(.caption).foregroundStyle(.orange)
+        } else if targets.agentPanes.isEmpty {
+            Text("No tmux pane is running Claude Code.").font(.caption).foregroundStyle(.secondary)
+        }
+
+        ForEach(targets.agentPanes) { pane in
+            Button {
+                targets.select(pane)
+            } label: {
+                HStack {
+                    Image(systemName: targets.target?.paneID == pane.id ? "largecircle.fill.circle" : "circle")
+                    Text(pane.label).lineLimit(1).truncationMode(.middle)
+                    Spacer()
+                    Text(pane.id).font(.caption.monospaced()).foregroundStyle(.tertiary)
+                }
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+        }
+
+        if targets.isTargetStale, let target = targets.target {
+            Label("\(target.label) is gone. Choose another pane.", systemImage: "exclamationmark.triangle")
+                .font(.caption)
+                .foregroundStyle(.orange)
+        }
+    }
+}
