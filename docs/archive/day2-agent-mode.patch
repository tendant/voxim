new file mode 100644
index 0000000..6726191
--- /dev/null
+++ b/voxim/App/AppController.swift
@@ -0,0 +1,186 @@
+//
+//  AppController.swift
+//  voxim
+//
+//  Agent mode: hold shortcut → record → transcribe → editable pending command →
+//  explicit confirm → deliver to the bound tmux pane.
+//
+
+import Foundation
+import os
+import Observation
+
+@Observable
+final class AppController {
+    enum Phase: Equatable {
+        case idle
+        case recording
+        case transcribing
+        case pending
+        case sending
+        case sent(String)
+        case failed(String)
+    }
+
+    /// Presses shorter than this are treated as accidental taps and discarded.
+    static let minimumHold: Duration = .milliseconds(250)
+
+    private(set) var phase: Phase = .idle
+    /// Editable pending command. Retained after a failed delivery so it can be retried or copied.
+    var pendingText = ""
+    private(set) var activeEngine = ""
+    /// Target captured when recording started; delivery re-validates it, and never substitutes another.
+    private(set) var pendingTarget: AgentTarget?
+
+    let targets: TargetManager
+    private let transcriber: FallbackTranscriber
+    private let capture = AudioCapture()
+    private var pressStarted: ContinuousClock.Instant?
+    private var keyHeld = false
+
+    /// Called when the pending panel should be shown or hidden.
+    var onPanelVisibilityChange: ((Bool) -> Void)?
+
+    init(
+        targets: TargetManager = TargetManager(),
+        transcriber: FallbackTranscriber = FallbackTranscriber(
+            primary: ParakeetTranscriber(), fallback: AppleSpeechTranscriber()
+        )
+    ) {
+        self.targets = targets
+        self.transcriber = transcriber
+        Task {
+            do {
+                try await transcriber.prepare()
+            } catch {
+                phase = .failed(error.localizedDescription)
+            }
+            await refreshEngineName()
+            await targets.refresh()
+        }
+    }
+
+    var isPanelVisible: Bool {
+        switch phase {
+        case .recording, .transcribing, .pending, .sending: true
+        case .failed: !pendingText.isEmpty
+        case .idle, .sent: false
+        }
+    }
+
+    // MARK: Push-to-talk
+
+    func agentKeyDown() {
+        keyHeld = true
+        switch phase {
+        case .idle, .sent, .failed: break
+        case .recording, .transcribing, .pending, .sending: return
+        }
+        guard let target = targets.target else {
+            fail("Choose a Claude Code pane from the voxim menu first.", keepText: false)
+            return
+        }
+        Task {
+            guard await AudioCapture.requestPermission() else {
+                fail(AudioCaptureError.microphoneDenied.localizedDescription, keepText: false)
+                return
+            }
+            // Released while the permission check was pending: don't start a recording.
+            guard keyHeld else { return }
+            do {
+                try capture.start()
+                pressStarted = .now
+                pendingTarget = target
+                pendingText = ""
+                setPhase(.recording)
+            } catch {
+                fail(error.localizedDescription, keepText: false)
+            }
+        }
+    }
+
+    func agentKeyUp() {
+        keyHeld = false
+        guard phase == .recording else { return }
+        let clip = capture.stop()
+        let held = pressStarted.map { ContinuousClock.now - $0 } ?? .zero
+        pressStarted = nil
+        guard held >= Self.minimumHold else {
+            setPhase(.idle)
+            return
+        }
+        setPhase(.transcribing)
+        Task {
+            let started = ContinuousClock.now
+            do {
+                let text = try await transcriber.transcribe(clip)
+                let elapsedMS = (ContinuousClock.now - started).timeInterval * 1000
+                Log.asr.info("transcribed \(clip.duration, format: .fixed(precision: 1))s audio in \(elapsedMS, format: .fixed(precision: 0)) ms")
+                await refreshEngineName()
+                guard !text.isEmpty else {
+                    fail("Nothing was recognized. Hold the shortcut and try again.", keepText: false)
+                    return
+                }
+                pendingText = text
+                setPhase(.pending)
+            } catch {
+                fail(error.localizedDescription, keepText: false)
+            }
+        }
+    }
+
+    // MARK: Pending command
+
+    func confirmSend() {
+        switch phase {
+        case .pending, .failed: break
+        default: return
+        }
+        guard let target = pendingTarget ?? targets.target else {
+            fail("Choose a Claude Code pane from the voxim menu first.", keepText: true)
+            return
+        }
+        let text = pendingText.trimmed
+        guard !text.isEmpty else { return }
+        setPhase(.sending)
+        Task {
+            do {
+                let receipt = try await targets.adapter.submit(text, to: target)
+                pendingText = ""
+                pendingTarget = nil
+                setPhase(.sent(receipt.target.label))
+            } catch {
+                fail(error.localizedDescription, keepText: true)
+                await targets.refresh()
+            }
+        }
+    }
+
+    func cancel() {
+        if phase == .recording { _ = capture.stop() }
+        pendingText = ""
+        pendingTarget = nil
+        setPhase(.idle)
+    }
+
+    /// After a stale-target failure the user re-selects; retry goes to the newly chosen pane.
+    func retarget() {
+        pendingTarget = targets.target
+    }
+
+    // MARK: Helpers
+
+    private func fail(_ message: String, keepText: Bool) {
+        if !keepText { pendingText = "" }
+        setPhase(.failed(message))
+    }
+
+    private func setPhase(_ newPhase: Phase) {
+        phase = newPhase
+        onPanelVisibilityChange?(isPanelVisible)
+    }
+
+    private func refreshEngineName() async {
+        activeEngine = await transcriber.activeName
+    }
+}
