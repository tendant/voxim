+++ b/voxim/UI/PendingPanel.swift
@@ -0,0 +1,124 @@
+//
+//  PendingPanel.swift
+//  voxim
+//
+//  Floating, non-activating panel: shows recording state and the editable pending command.
+//  It can take keyboard focus for editing without activating voxim, so the terminal stays frontmost.
+//
+
+import AppKit
+import SwiftUI
+
+final class PendingPanel: NSPanel {
+    init(controller: AppController) {
+        super.init(
+            contentRect: NSRect(x: 0, y: 0, width: 560, height: 160),
+            styleMask: [.nonactivatingPanel, .titled, .fullSizeContentView],
+            backing: .buffered,
+            defer: true
+        )
+        isFloatingPanel = true
+        level = .floating
+        titleVisibility = .hidden
+        titlebarAppearsTransparent = true
+        isMovableByWindowBackground = true
+        hidesOnDeactivate = false
+        collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
+        standardWindowButton(.closeButton)?.isHidden = true
+        standardWindowButton(.miniaturizeButton)?.isHidden = true
+        standardWindowButton(.zoomButton)?.isHidden = true
+
+        let hosting = NSHostingView(rootView: PendingView(controller: controller))
+        hosting.sizingOptions = [.preferredContentSize]
+        contentView = hosting
+    }
+
+    override var canBecomeKey: Bool { true }
+
+    func show(focus: Bool) {
+        if !isVisible, let screen = NSScreen.main {
+            let frame = screen.visibleFrame
+            setFrameTopLeftPoint(NSPoint(x: frame.midX - self.frame.width / 2, y: frame.maxY - 80))
+        }
+        if focus { makeKeyAndOrderFront(nil) } else { orderFrontRegardless() }
+    }
+}
+
+struct PendingView: View {
+    @Bindable var controller: AppController
+    @FocusState private var editorFocused: Bool
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            header
+            switch controller.phase {
+            case .recording:
+                Label("Listening… release to finish", systemImage: "mic.fill")
+                    .foregroundStyle(.red)
+                    .font(.title3)
+            case .transcribing:
+                Label("Transcribing…", systemImage: "waveform")
+                    .font(.title3)
+            case .pending, .sending, .failed:
+                editor
+            case .idle, .sent:
+                EmptyView()
+            }
+        }
+        .padding(16)
+        .frame(width: 560, alignment: .leading)
+        .onChange(of: controller.phase) { _, phase in
+            if phase == .pending { editorFocused = true }
+        }
+    }
+
+    private var header: some View {
+        HStack(spacing: 6) {
+            Image(systemName: "terminal")
+            Text(controller.pendingTarget?.label ?? "No target")
+                .lineLimit(1)
+                .truncationMode(.middle)
+            Spacer()
+            Text(controller.activeEngine)
+                .foregroundStyle(.tertiary)
+        }
+        .font(.caption)
+        .foregroundStyle(.secondary)
+    }
+
+    @ViewBuilder private var editor: some View {
+        TextField("Command for Claude Code", text: $controller.pendingText, axis: .vertical)
+            .textFieldStyle(.plain)
+            .font(.title3)
+            .lineLimit(1...6)
+            .focused($editorFocused)
+            .onSubmit(controller.confirmSend)
+            .disabled(controller.phase == .sending)
+
+        if case .failed(let message) = controller.phase {
+            Label(message, systemImage: "exclamationmark.triangle.fill")
+                .font(.callout)
+                .foregroundStyle(.orange)
+            if let selected = controller.targets.target, selected.paneID != controller.pendingTarget?.paneID {
+                Button("Send to \(selected.label) instead", action: controller.retarget)
+                    .buttonStyle(.link)
+            }
+        }
+
+        HStack {
+            Text("⏎ send · ⌥⏎ new line · esc cancel")
+                .font(.caption)
+                .foregroundStyle(.tertiary)
+            Spacer()
+            Button("Copy") {
+                NSPasteboard.general.clearContents()
+                NSPasteboard.general.setString(controller.pendingText, forType: .string)
+            }
+            Button("Cancel", role: .cancel, action: controller.cancel)
+                .keyboardShortcut(.cancelAction)
+            Button(controller.phase == .sending ? "Sending…" : "Send", action: controller.confirmSend)
+                .keyboardShortcut(.defaultAction)
+                .disabled(controller.pendingText.trimmed.isEmpty || controller.phase == .sending)
+        }
+    }
+}
diff --git a/voximTests/TmuxAdapterTests.swift b/voximTests/TmuxAdapterTests.swift
new file mode 100644
index 0000000..49b16ad
--- /dev/null
+++ b/voximTests/TmuxAdapterTests.swift
@@ -0,0 +1,149 @@
+//
+//  TmuxAdapterTests.swift
+//  voximTests
+//
+
+import Foundation
+import Testing
+@testable import voxim
+
+/// Scripted stand-in for tmux/ps. Records every call; never touches a real tmux server.
+final class FakeRunner: ProcessRunning, @unchecked Sendable {
+    struct Call: Equatable {
+        var tool: String
+        var arguments: [String]
+        var stdin: String?
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    var calls: [Call] { lock.withLock { _calls } }
+
+    var panes = [
+        "%6|~|0:2.0|~|/dev/ttys008|~|✳ Plan to implement",
+        "%10|~|0:5.0|~|/dev/ttys011|~|Mac |~| title with delimiter",
+    ]
+    var ps = """
+    ttys008  S+   claude
+    ttys011  Ss+  -zsh
+    ttys004  S    claude
+    ??       S    /Applications/Claude Code/claude
+    """
+    var failing: Set<String> = []
+
+    func run(_ executable: URL, _ arguments: [String], stdin: Data?) async throws -> ProcessResult {
+        let tool = executable.lastPathComponent
+        lock.withLock {
+            _calls.append(Call(tool: tool, arguments: arguments, stdin: stdin.map { String(decoding: $0, as: UTF8.self) }))
+        }
+        if tool == "ps" { return ProcessResult(status: 0, stdout: ps, stderr: "") }
+        guard tool == "tmux", arguments.first == "-u" else {
+            return ProcessResult(status: 1, stdout: "", stderr: "expected tmux -u")
+        }
+        let tmuxArguments = Array(arguments.dropFirst())
+        let subcommand = tmuxArguments.first ?? ""
+        if failing.contains(subcommand) { return ProcessResult(status: 1, stdout: "", stderr: "\(subcommand) failed") }
+        switch subcommand {
+        case "list-panes":
+            return ProcessResult(status: 0, stdout: panes.joined(separator: "\n") + "\n", stderr: "")
+        case "display-message":
+            let id = tmuxArguments[tmuxArguments.firstIndex(of: "-t")! + 1]
+            guard let line = panes.first(where: { $0.hasPrefix(id + TmuxAdapter.fieldDelimiter) }) else {
+                return ProcessResult(status: 1, stdout: "", stderr: "can't find pane: \(id)")
+            }
+            return ProcessResult(status: 0, stdout: line + "\n", stderr: "")
+        default:
+            return ProcessResult(status: 0, stdout: "", stderr: "")
+        }
+    }
+
+    var tmuxSubcommands: [String] { calls.filter { $0.tool == "tmux" }.map { $0.arguments[1] } }
+}
+
+struct TmuxAdapterTests {
+    let runner = FakeRunner()
+    var adapter: TmuxAdapter { TmuxAdapter(runner: runner, tmuxPath: URL(fileURLWithPath: "/usr/bin/tmux")) }
+    let claudePane = AgentTarget(paneID: "%6", label: "0:2.0 · Plan to implement")
+
+    @Test func listsPanesAndMarksForegroundClaudeAsAgent() async throws {
+        let panes = try await adapter.listPanes()
+        #expect(panes.map(\.id) == ["%6", "%10"])
+        #expect(panes.map(\.isAgent) == [true, false])
+        #expect(panes[0].label == "0:2.0 · Plan to implement")
+        #expect(panes[1].tty == "ttys011")
+        #expect(panes[1].title == "Mac |~| title with delimiter")
+    }
+
+    @Test func backgroundedClaudeIsNotAnAgent() {
+        // ttys004 runs claude without '+' (not foreground); '??' has no tty.
+        #expect(TmuxAdapter.parseAgentTTYs(runner.ps) == ["ttys008"])
+    }
+
+    @Test func submitPastesThenPressesEnter() async throws {
+        let receipt = try await adapter.submit("  Run the unit tests and fix the failures \n", to: claudePane)
+
+        #expect(receipt.boundary == .injectedIntoTerminal)
+        #expect(receipt.target == claudePane)
+        #expect(runner.tmuxSubcommands == ["display-message", "load-buffer", "paste-buffer", "send-keys"])
+
+        let calls = runner.calls.filter { $0.tool == "tmux" }
+        #expect(calls[1].stdin == "Run the unit tests and fix the failures")
+        #expect(calls[2].arguments.contains("-p"))
+        #expect(calls[2].arguments.suffix(2) == ["-t", "%6"])
+        #expect(calls[3].arguments == ["-u", "send-keys", "-t", "%6", "Enter"])
+    }
+
+    @Test func missingPaneFailsWithoutSendingAnything() async {
+        let gone = AgentTarget(paneID: "%99", label: "0:9.0 · old session")
+        await #expect(throws: AgentDeliveryError.targetGone("0:9.0 · old session")) {
+            try await adapter.submit("hello", to: gone)
+        }
+        #expect(runner.tmuxSubcommands == ["display-message"])
+    }
+
+    @Test func paneWithoutClaudeInForegroundIsRejected() async {
+        runner.ps = "ttys008  Ss+  -zsh\n"
+        await #expect(throws: AgentDeliveryError.notAnAgent(claudePane.label)) {
+            try await adapter.submit("hello", to: claudePane)
+        }
+        #expect(!runner.tmuxSubcommands.contains("send-keys"))
+    }
+
+    @Test func failedPasteNeverPressesEnter() async {
+        runner.failing = ["paste-buffer"]
+        await #expect(throws: AgentDeliveryError.commandFailed("paste-buffer failed")) {
+            try await adapter.submit("hello", to: claudePane)
+        }
+        #expect(runner.tmuxSubcommands == ["display-message", "load-buffer", "paste-buffer", "delete-buffer"])
+    }
+
+    @Test func emptyCommandIsRejectedBeforeTouchingTmux() async {
+        await #expect(throws: AgentDeliveryError.emptyCommand) {
+            try await adapter.submit(" \n\u{1B} ", to: claudePane)
+        }
+        #expect(runner.calls.isEmpty)
+    }
+
+    @Test func missingTmuxBinaryIsReported() async {
+        let adapter = TmuxAdapter(runner: runner, tmuxPath: nil)
+        await #expect(throws: AgentDeliveryError.tmuxNotFound) {
+            try await adapter.submit("hello", to: claudePane)
+        }
+    }
+
+    @Test func sanitizeStripsTerminalControlSequences() {
+        // An ESC could terminate bracketed paste early and smuggle keystrokes.
+        #expect(TmuxAdapter.sanitize("fix it\u{1B}[201~\r rm -rf") == "fix it[201~ rm -rf")
+        #expect(TmuxAdapter.sanitize("line one\nline two\ttab") == "line one\nline two\ttab")
+    }
+
+    @Test func noServerMeansNoPanes() async throws {
+        struct NoServer: ProcessRunning {
+            func run(_ executable: URL, _ arguments: [String], stdin: Data?) async throws -> ProcessResult {
+                ProcessResult(status: 1, stdout: "", stderr: "no server running on /private/tmp/tmux-501/default")
+            }
+        }
+        let adapter = TmuxAdapter(runner: NoServer(), tmuxPath: URL(fileURLWithPath: "/usr/bin/tmux"))
+        #expect(try await adapter.listPanes().isEmpty)
+    }
+}
