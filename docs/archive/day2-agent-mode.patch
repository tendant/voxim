+//
+//  ShortcutManager.swift
+//  voxim
+//
+
+import AppKit
+import KeyboardShortcuts
+
+extension KeyboardShortcuts.Name {
+    /// Agent mode push-to-talk. Default ⌥⇧Space; remappable in the menu.
+    static let agentPushToTalk = Self("agentPushToTalk", initial: .init(.space, modifiers: [.option, .shift]))
+}
+
+/// Registers system-wide push-to-talk hotkeys (Carbon hotkeys; no Accessibility permission needed).
+enum ShortcutManager {
+    static func register(_ controller: AppController) {
+        KeyboardShortcuts.onKeyDown(for: .agentPushToTalk) { controller.agentKeyDown() }
+        KeyboardShortcuts.onKeyUp(for: .agentPushToTalk) { controller.agentKeyUp() }
+    }
+}
