+++ b/voxim/Agent/AgentAdapter.swift
@@ -0,0 +1,53 @@
+//
+//  AgentAdapter.swift
+//  voxim
+//
+
+import Foundation
+
+/// An explicitly bound coding-agent input. Never inferred from focus.
+nonisolated struct AgentTarget: Codable, Hashable, Sendable {
+    /// tmux pane id (e.g. `%7`); stable for the pane's lifetime and not reused by the server.
+    var paneID: String
+    /// Human-readable identity shown before sending, e.g. `0:2.0 · Plan to implement`.
+    var label: String
+}
+
+/// What the adapter can actually vouch for. Injection is not acceptance by the agent.
+nonisolated struct DeliveryReceipt: Sendable {
+    enum Boundary: String, Sendable {
+        case injectedIntoTerminal = "injected_into_terminal"
+    }
+
+    var target: AgentTarget
+    var boundary: Boundary
+    var date: Date
+}
+
+nonisolated enum AgentDeliveryError: LocalizedError, Equatable {
+    case tmuxNotFound
+    case targetGone(String)
+    case notAnAgent(String)
+    case emptyCommand
+    case commandFailed(String)
+
+    var errorDescription: String? {
+        switch self {
+        case .tmuxNotFound:
+            "tmux was not found in /opt/homebrew/bin, /usr/local/bin or /usr/bin."
+        case .targetGone(let label):
+            "The selected pane (\(label)) no longer exists. Choose a target again."
+        case .notAnAgent(let label):
+            "Claude Code is no longer running in the foreground of \(label). Choose a target again."
+        case .emptyCommand:
+            "There is nothing to send."
+        case .commandFailed(let message):
+            "tmux failed: \(message)"
+        }
+    }
+}
+
+nonisolated protocol AgentAdapter: Sendable {
+    func validate(_ target: AgentTarget) async throws
+    func submit(_ text: String, to target: AgentTarget) async throws -> DeliveryReceipt
+}
