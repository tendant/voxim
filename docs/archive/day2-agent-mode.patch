--- /dev/null
+++ b/voxim/Agent/TargetManager.swift
@@ -0,0 +1,67 @@
+//
+//  TargetManager.swift
+//  voxim
+//
+
+import Foundation
+import Observation
+
+/// Holds the explicitly selected agent target. Never auto-selects or re-routes:
+/// if the bound pane disappears, the binding stays and delivery fails until the user re-selects.
+@Observable
+final class TargetManager {
+    private static let defaultsKey = "agentTarget"
+
+    private(set) var panes: [TmuxPane] = []
+    private(set) var listError: String?
+    private(set) var target: AgentTarget? {
+        didSet { persist() }
+    }
+
+    let adapter: TmuxAdapter
+
+    init(adapter: TmuxAdapter = TmuxAdapter()) {
+        self.adapter = adapter
+        if let data = UserDefaults.standard.data(forKey: Self.defaultsKey) {
+            target = try? JSONDecoder().decode(AgentTarget.self, from: data)
+        }
+    }
+
+    var agentPanes: [TmuxPane] { panes.filter(\.isAgent) }
+
+    /// True when the last refresh no longer sees the bound pane running an agent.
+    var isTargetStale: Bool {
+        guard let target, listError == nil else { return false }
+        return !agentPanes.contains { $0.id == target.paneID }
+    }
+
+    func refresh() async {
+        do {
+            panes = try await adapter.listPanes()
+            listError = nil
+            // Keep the label current (titles change as Claude works) without changing the binding.
+            if let target, let pane = panes.first(where: { $0.id == target.paneID }), pane.isAgent {
+                self.target = pane.target
+            }
+        } catch {
+            panes = []
+            listError = error.localizedDescription
+        }
+    }
+
+    func select(_ pane: TmuxPane) {
+        target = pane.target
+    }
+
+    func clear() {
+        target = nil
+    }
+
+    private func persist() {
+        if let target, let data = try? JSONEncoder().encode(target) {
+            UserDefaults.standard.set(data, forKey: Self.defaultsKey)
+        } else {
+            UserDefaults.standard.removeObject(forKey: Self.defaultsKey)
+        }
+    }
+}
diff --git a/voxim/Agent/TmuxAdapter.swift b/voxim/Agent/TmuxAdapter.swift
new file mode 100644
index 0000000..b340495
--- /dev/null
+++ b/voxim/Agent/TmuxAdapter.swift
@@ -0,0 +1,157 @@
+//
+//  TmuxAdapter.swift
+//  voxim
+//
+//  Delivers confirmed commands to an explicitly bound tmux pane running Claude Code.
+//
+
+import Foundation
+import os
+
+nonisolated struct TmuxPane: Hashable, Sendable, Identifiable {
+    var id: String          // pane id, e.g. %7
+    var location: String    // session:window.pane
+    var tty: String         // e.g. ttys008
+    var title: String
+    var isAgent: Bool
+
+    var label: String {
+        // Claude Code prefixes its terminal title with a status glyph (✳, spinner frames).
+        let cleaned = title.drop { !$0.isLetter && !$0.isNumber }
+        return cleaned.isEmpty ? location : "\(location) · \(cleaned)"
+    }
+
+    var target: AgentTarget { AgentTarget(paneID: id, label: label) }
+}
+
+nonisolated struct TmuxAdapter: AgentAdapter {
+    static let candidatePaths = ["/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux"]
+    /// Foreground process names that identify a supported coding agent.
+    static let agentCommands: Set<String> = ["claude"]
+
+    /// GUI apps run without a UTF-8 locale, where tmux rewrites control characters (tabs) and
+    /// non-ASCII to `_`. So: printable delimiter, `-u` for UTF-8, and free-form title last.
+    static let fieldDelimiter = "|~|"
+    private static let paneFormat = ["#{pane_id}", "#{session_name}:#{window_index}.#{pane_index}", "#{pane_tty}", "#{pane_title}"]
+        .joined(separator: fieldDelimiter)
+
+    let runner: any ProcessRunning
+    let tmuxPath: URL?
+
+    init(
+        runner: any ProcessRunning = SystemProcessRunner(),
+        tmuxPath: URL? = TmuxAdapter.candidatePaths.first { FileManager.default.isExecutableFile(atPath: $0) }
+            .map(URL.init(fileURLWithPath:))
+    ) {
+        self.runner = runner
+        self.tmuxPath = tmuxPath
+    }
+
+    // MARK: Discovery
+
+    func listPanes() async throws -> [TmuxPane] {
+        let result = try await tmux(["list-panes", "-a", "-F", Self.paneFormat])
+        guard result.status == 0 else {
+            // No server running means no panes, not an error worth surfacing.
+            if result.stderr.contains("no server running") || result.stderr.contains("error connecting") { return [] }
+            throw AgentDeliveryError.commandFailed(result.stderr.trimmed)
+        }
+        let agentTTYs = try await foregroundAgentTTYs()
+        return result.stdout.split(separator: "\n").compactMap { line in
+            Self.parsePane(String(line), agentTTYs: agentTTYs)
+        }
+    }
+
+    // MARK: AgentAdapter
+
+    func validate(_ target: AgentTarget) async throws {
+        _ = try await validatedPane(target)
+    }
+
+    func submit(_ text: String, to target: AgentTarget) async throws -> DeliveryReceipt {
+        let command = Self.sanitize(text)
+        guard !command.isEmpty else { throw AgentDeliveryError.emptyCommand }
+        let pane = try await validatedPane(target)
+
+        let buffer = "voxim-\(UUID().uuidString)"
+        try await check(tmux(["load-buffer", "-b", buffer, "-"], stdin: Data(command.utf8)))
+        do {
+            // -p: bracketed paste so embedded newlines don't submit early; -d: delete buffer after.
+            try await check(tmux(["paste-buffer", "-p", "-d", "-b", buffer, "-t", pane.id]))
+        } catch {
+            _ = try? await tmux(["delete-buffer", "-b", buffer])
+            throw error
+        }
+        // Give the TUI a beat to process the paste before Enter arrives.
+        try await Task.sleep(for: .milliseconds(80))
+        try await check(tmux(["send-keys", "-t", pane.id, "Enter"]))
+        Log.agent.info("delivered to pane \(pane.id, privacy: .public) boundary=injected_into_terminal")
+        return DeliveryReceipt(target: target, boundary: .injectedIntoTerminal, date: .now)
+    }
+
+    // MARK: Internals
+
+    private func validatedPane(_ target: AgentTarget) async throws -> TmuxPane {
+        let result = try await tmux(["display-message", "-p", "-t", target.paneID, Self.paneFormat])
+        guard result.status == 0,
+              let pane = Self.parsePane(result.stdout.trimmed, agentTTYs: []),
+              pane.id == target.paneID
+        else { throw AgentDeliveryError.targetGone(target.label) }
+
+        guard try await foregroundAgentTTYs().contains(pane.tty) else {
+            throw AgentDeliveryError.notAnAgent(target.label)
+        }
+        return pane
+    }
+
+    /// TTYs whose foreground process group contains a known agent binary.
+    private func foregroundAgentTTYs() async throws -> Set<String> {
+        let ps = try await runner.run(URL(fileURLWithPath: "/bin/ps"), ["-A", "-o", "tty=,stat=,comm="], stdin: nil)
+        return Self.parseAgentTTYs(ps.stdout)
+    }
+
+    private func tmux(_ arguments: [String], stdin: Data? = nil) async throws -> ProcessResult {
+        guard let tmuxPath else { throw AgentDeliveryError.tmuxNotFound }
+        return try await runner.run(tmuxPath, ["-u"] + arguments, stdin: stdin)
+    }
+
+    private func check(_ result: ProcessResult) throws {
+        guard result.status == 0 else { throw AgentDeliveryError.commandFailed(result.stderr.trimmed) }
+    }
+
+    static func parsePane(_ line: String, agentTTYs: Set<String>) -> TmuxPane? {
+        let fields = line.split(separator: fieldDelimiter, maxSplits: 3, omittingEmptySubsequences: false).map(String.init)
+        guard fields.count >= 3, fields[0].hasPrefix("%") else { return nil }
+        let tty = fields[2].replacingOccurrences(of: "/dev/", with: "")
+        return TmuxPane(
+            id: fields[0],
+            location: fields[1],
+            tty: tty,
+            title: fields.count > 3 ? fields[3] : "",
+            isAgent: agentTTYs.contains(tty)
+        )
+    }
+
+    static func parseAgentTTYs(_ psOutput: String) -> Set<String> {
+        var ttys: Set<String> = []
+        for line in psOutput.split(separator: "\n") {
+            let parts = line.split(separator: " ", maxSplits: 2, omittingEmptySubsequences: true)
+            guard parts.count == 3, parts[1].contains("+") else { continue }
+            let name = (String(parts[2]).trimmed as NSString).lastPathComponent
+            if agentCommands.contains(name) { ttys.insert(String(parts[0])) }
+        }
+        return ttys
+    }
+
+    /// Recognized speech is user input, but it must not carry terminal control sequences
+    /// (e.g. an ESC that ends bracketed paste early). Keep newlines and tabs only.
+    static func sanitize(_ text: String) -> String {
+        String(String.UnicodeScalarView(text.unicodeScalars.filter { scalar in
+            scalar == "\n" || scalar == "\t" || !(scalar.properties.generalCategory == .control)
+        })).trimmed
+    }
+}
+
+extension String {
+    nonisolated var trimmed: String { trimmingCharacters(in: .whitespacesAndNewlines) }
+}
