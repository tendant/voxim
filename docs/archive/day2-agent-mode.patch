index 0000000..13267f1
--- /dev/null
+++ b/voximTests/TmuxIntegrationTests.swift
@@ -0,0 +1,68 @@
+//
+//  TmuxIntegrationTests.swift
+//  voximTests
+//
+//  Opt-in: runs against the real tmux server in a throwaway session.
+//  TEST_RUNNER_VOXIM_TMUX_IT=1 xcodebuild test -only-testing:voximTests/TmuxIntegrationTests ...
+//
+
+import Foundation
+import Testing
+@testable import voxim
+
+@Suite(.enabled(if: ProcessInfo.processInfo.environment["VOXIM_TMUX_IT"] == "1"), .serialized)
+struct TmuxIntegrationTests {
+    let adapter = TmuxAdapter()
+    let runner = SystemProcessRunner()
+
+    /// Starts a detached session whose foreground process is a `cat` copy named `claude`,
+    /// so it passes agent validation and echoes whatever is delivered into `output`.
+    private func startFakeAgent() async throws -> (session: String, pane: String, output: URL) {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("voxim-it-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let fakeClaude = dir.appendingPathComponent("claude")
+        try FileManager.default.copyItem(atPath: "/bin/cat", toPath: fakeClaude.path)
+        // A copied platform binary is SIGKILLed on launch unless re-signed.
+        let signed = try await runner.run(
+            URL(fileURLWithPath: "/usr/bin/codesign"), ["-f", "-s", "-", fakeClaude.path], stdin: nil
+        )
+        try #require(signed.status == 0, "codesign failed: \(signed.stderr)")
+        let output = dir.appendingPathComponent("out.txt")
+        let session = "voxim-it-\(Int.random(in: 1000...9999))"
+
+        let tmux = try #require(adapter.tmuxPath)
+        let created = try await runner.run(
+            tmux,
+            ["new-session", "-d", "-s", session, "-P", "-F", "#{pane_id}", "exec '\(fakeClaude.path)' > '\(output.path)'"],
+            stdin: nil
+        )
+        try #require(created.status == 0, "new-session failed: \(created.stderr)")
+        try await Task.sleep(for: .milliseconds(300))
+        return (session, created.stdout.trimmed, output)
+    }
+
+    private func kill(_ session: String) async {
+        guard let tmux = adapter.tmuxPath else { return }
+        _ = try? await runner.run(tmux, ["kill-session", "-t", session], stdin: nil)
+    }
+
+    @Test func deliversToBoundPaneThenRefusesOnceItIsGone() async throws {
+        let (session, paneID, output) = try await startFakeAgent()
+        defer { Task { await kill(session) } }
+
+        let panes = try await adapter.listPanes()
+        let pane = try #require(panes.first { $0.id == paneID }, "pane \(paneID) not in \(panes.map { "\($0.id) \($0.location) agent=\($0.isAgent)" })")
+        #expect(pane.isAgent)
+
+        let receipt = try await adapter.submit("Run the unit tests and fix the failures", to: pane.target)
+        #expect(receipt.boundary == .injectedIntoTerminal)
+        try await Task.sleep(for: .milliseconds(300))
+        #expect(try String(contentsOf: output, encoding: .utf8) == "Run the unit tests and fix the failures\n")
+
+        await kill(session)
+        try await Task.sleep(for: .milliseconds(200))
+        await #expect(throws: AgentDeliveryError.targetGone(pane.target.label)) {
+            try await adapter.submit("this must not be delivered anywhere", to: pane.target)
+        }
+    }
+}
